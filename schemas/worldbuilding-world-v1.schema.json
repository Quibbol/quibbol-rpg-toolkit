{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quibbol.github.io/quibbol-rpg-toolkit/schemas/worldbuilding-world-v1.schema.json",
  "title": "Quibbol’s RPG Toolkit - Mundo agnóstico",
  "type": "object",
  "required": ["_quibbolRpgToolkit", "_worldFile", "settings"],
  "properties": {
    "_quibbolRpgToolkit": {
      "type": "object",
      "required": ["application", "formatVersion", "module", "system", "entity", "schemaVersion"],
      "properties": {
        "application": {"const": "quibbol-rpg-toolkit"},
        "formatVersion": {"const": 1},
        "module": {"const": "worldbuilding"},
        "system": {"const": "agnostic"},
        "entity": {"const": "world"},
        "schemaVersion": {"const": 1},
        "exportedAt": {"type": "string"}
      },
      "additionalProperties": true
    },
    "_worldFile": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "settings": {
      "type": "object",
      "required": ["worldName"],
      "properties": {
        "worldName": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
