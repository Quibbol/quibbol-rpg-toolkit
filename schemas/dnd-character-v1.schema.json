{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quibbol.github.io/quibbol-rpg-toolkit/schemas/dnd-character-v1.schema.json",
  "title": "Quibbol’s RPG Toolkit - Ficha de personaje D&D 5e 2024",
  "type": "object",
  "required": ["_quibbolRpgToolkit", "characters"],
  "properties": {
    "_quibbolRpgToolkit": {
      "type": "object",
      "required": ["application", "formatVersion", "module", "system", "entity", "schemaVersion"],
      "properties": {
        "application": {"const": "quibbol-rpg-toolkit"},
        "formatVersion": {"const": 1},
        "module": {"const": "character-sheet"},
        "system": {"const": "dnd-5e-2024"},
        "entity": {"const": "character"},
        "schemaVersion": {"const": 1},
        "exportedAt": {"type": "string"}
      },
      "additionalProperties": true
    },
    "theme": {"enum": ["light", "dark"]},
    "activeId": {"type": "string"},
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object"}
    }
  },
  "additionalProperties": true
}
